# Install as ~/.config/atypica/sandbox-runner.env with mode 0600 on the
# dedicated Runner account. Never use this token in a browser or public env.
NODE_ENV=production
SANDBOX_RUNNER_HOST=127.0.0.1
SANDBOX_RUNNER_PORT=8787
SANDBOX_RUNNER_AUTH_TOKEN=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES

# Production execution is rootless and images are immutable. Pull these exact
# references before starting the unit. Update only through a reviewed deploy.
SANDBOX_CONTAINER_RUNTIME=podman
SANDBOX_JAVASCRIPT_IMAGE=node@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43
SANDBOX_PYTHON_IMAGE=python@sha256:540c7d91f98ff6880174c40e99067bf5941eb54d818a7a5e094d188b196a934d
SANDBOX_RUNNER_REQUIRE_IMAGE_DIGEST=1

SANDBOX_RUNNER_MAX_CONCURRENCY=4
SANDBOX_RUNNER_MAX_REQUEST_BYTES=524288
SANDBOX_RUNNER_CPU_LIMIT=1
SANDBOX_RUNNER_PIDS_LIMIT=64
SANDBOX_RUNNER_TMPFS_MB=16

# Keep empty for default-deny networking. Enabling this requires a dedicated
# network whose outbound destinations are restricted outside this process.
SANDBOX_RUNNER_EGRESS_NETWORK=
