# Server-only OpenAI credential. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Public HTTPS origin used for production CSRF origin checks. Do not derive this
# from untrusted X-Forwarded-* headers.
PUBLIC_APP_ORIGIN=https://app.example.com
# Production rate limiting should be enforced at the edge or with a shared
# Redis-backed limiter when more than one web instance is running.

# Stage routing. "yundu" uses the OpenAI-compatible gateway configured below;
# "deepseek" remains available when a stage must use the native DeepSeek API.
PLAN_PROVIDER=yundu
RESEARCH_PROVIDER=yundu
REASONING_PROVIDER=yundu
REPORT_PROVIDER=yundu
REPORT_JUDGE_PROVIDER=yundu
FOLLOWUP_PROVIDER=yundu

# OpenAI-compatible fallback configuration.
OPENAI_PLAN_MODEL=gpt-5.6-terra
OPENAI_RESEARCH_MODEL=gpt-5.6-terra
REASONING_MODEL=gpt-5.6-terra
OPENAI_FOLLOWUP_MODEL=gpt-5.6-terra
# Final Universal Agent text uses Chat Completions by default for low-latency
# deltas; set to responses only when the gateway streams Responses reliably.
UNIVERSAL_AGENT_FINAL_PROTOCOL=chat_completions
REPORT_MODEL=gpt-5.6-terra
REPORT_JUDGE_MODEL=gpt-5.6-terra

# OpenAI-compatible gateway metadata and API protocol.
OPENAI_PROVIDER_NAME=yundu
OPENAI_API_PROTOCOL=chat_completions
OPENAI_BASE_URL=https://yundu.lol/v1

# DeepSeek configuration for planning, research execution, and report follow-ups.
# DeepSeek is stateless, so follow-up turns are persisted and replayed by the application.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_PROTOCOL=responses
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
DEEPSEEK_PLAN_MODEL=deepseek-v4-flash
DEEPSEEK_RESEARCH_MODEL=deepseek-v4-flash
DEEPSEEK_FOLLOWUP_MODEL=deepseek-v4-flash

# Recommended public-web search provider. Bing HTML search is used as a fallback.
TAVILY_API_KEY=

# Optional GPT Researcher execution engine. Keep it private behind the bridge
# token; the Next app remains the owner of users, workspaces and report gates.
# Set RESEARCH_ENGINE to "gpt-researcher" only after the Python service is up.
RESEARCH_ENGINE=local
GPT_RESEARCHER_URL=http://127.0.0.1:8000
GPT_RESEARCHER_BRIDGE_TOKEN=
# Full GPT Researcher runs are longer than ordinary connector calls. Abort a
# silent bridge early and fall back to the local DeepSeek/Tavily research path.
GPT_RESEARCHER_TASK_TIMEOUT_SECONDS=900
GPT_RESEARCHER_BRIDGE_RUN_TIMEOUT_SECONDS=720
GPT_RESEARCHER_IDLE_TIMEOUT_SECONDS=120
GPT_RESEARCHER_FALLBACK_TO_LOCAL=true
# The following limits are read by the Python bridge (configure them in its .env,
# not required by the Next.js process).
GPT_RESEARCHER_BRIDGE_TTL_SECONDS=21600
GPT_RESEARCHER_BRIDGE_EVENT_LIMIT=2000

# Optional official public Bluesky AppView connector. Search results remain discovery
# candidates until app.bsky.feed.getPosts creates an immutable source snapshot.
BLUESKY_SOCIAL_CONNECTOR_ENABLED=false
BLUESKY_PUBLIC_API_URL=https://public.api.bsky.app

# S3-compatible immutable raw source storage (AWS S3, Cloudflare R2, MinIO, etc.).
# When it is unavailable, bounded source bodies fall back to inline PostgreSQL storage
# so a research run can still finish. Set this limit to 0 only with external storage.
SOURCE_RAW_INLINE_LIMIT_BYTES=65536
SOURCE_RAW_INLINE_FALLBACK_LIMIT_BYTES=2097152
SOURCE_OBJECT_STORAGE_BUCKET=
SOURCE_OBJECT_STORAGE_REGION=us-east-1
SOURCE_OBJECT_STORAGE_ENDPOINT=
SOURCE_OBJECT_STORAGE_FORCE_PATH_STYLE=false
SOURCE_OBJECT_STORAGE_ACCESS_KEY_ID=
SOURCE_OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Dedicated embedding candidate used only by the offline Context evaluation gate.
# When OPENAI_BASE_URL is customized, OPENAI_EMBEDDING_BASE_URL is required and
# must expose the route selected by CONTEXT_EMBEDDING_API_STYLE.
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_PROVIDER_NAME=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_VERSION=text-embedding-3-small-v1
CONTEXT_EMBEDDING_API_STYLE=openai
CONTEXT_EMBEDDING_EVALUATION_BATCH_SIZE=64
CONTEXT_EMBEDDING_EVALUATION_TIMEOUT_MS=60000

# Volcengine Ark alternative. Its multimodal endpoint creates one vector per
# request, so the evaluation batch size controls request concurrency.
# OPENAI_EMBEDDING_API_KEY=<Ark API key>
# OPENAI_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# OPENAI_EMBEDDING_PROVIDER_NAME=volcengine-ark
# OPENAI_EMBEDDING_MODEL=<ep-... endpoint ID>
# OPENAI_EMBEDDING_VERSION=doubao-embedding-vision-251215
# CONTEXT_EMBEDDING_API_STYLE=volcengine_multimodal
# CONTEXT_EMBEDDING_EVALUATION_BATCH_SIZE=10

# Qwen alternative through Alibaba Cloud Model Studio's OpenAI-compatible API.
# Keep the OPENAI_EMBEDDING_* names: they identify this app's compatible adapter,
# while PROVIDER_NAME records the actual vendor in evaluation telemetry.
# OPENAI_EMBEDDING_API_KEY=<regional Model Studio API key>
# OPENAI_EMBEDDING_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# OPENAI_EMBEDDING_PROVIDER_NAME=qwen-dashscope
# OPENAI_EMBEDDING_MODEL=text-embedding-v4
# OPENAI_EMBEDDING_VERSION=text-embedding-v4
# CONTEXT_EMBEDDING_API_STYLE=openai
# text-embedding-v4 accepts at most 10 input texts per request.
# CONTEXT_EMBEDDING_EVALUATION_BATCH_SIZE=10

# Supabase project settings. The publishable key is safe for browser use with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only PostgreSQL pooler connection string. Never expose this to the browser.
DATABASE_URL=

# One-time platform admin bootstrap (never expose the service role key to the browser).
# For an already registered account, only PLATFORM_ADMIN_EMAIL is needed.
SUPABASE_SERVICE_ROLE_KEY=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=平台管理员
DATABASE_POOL_SIZE=5
# Set to disable only for a trusted local PostgreSQL instance without TLS.
# Use verify-full in production. "require" encrypts traffic without verifying
# the server certificate and is retained only for legacy database providers.
DATABASE_SSL_MODE=verify-full
# Optional PEM CA certificate. Literal \\n sequences are supported.
DATABASE_SSL_CA=

# Production defaults to the shared PostgreSQL limiter; local development uses memory.
RATE_LIMIT_BACKEND=database
# RATE_LIMIT_FAIL_OPEN=1 is honored only outside production.
RATE_LIMIT_FAIL_OPEN=0
HEALTH_REQUIRE_WORKER=1

# Comma-separated HTTPS origins for governed HTTP, MCP, and sandbox executors.
# A production sandbox runner must be isolated from the Next.js process.
SKILL_EXECUTOR_ALLOWED_ORIGINS=
# Secret sent only from the Next.js server to the Sandbox Runner. Its value must
# match SANDBOX_RUNNER_AUTH_TOKEN in the separately deployed Runner service.
SKILL_SECRET_SANDBOX_RUNNER_TOKEN=

# Independent atypica.sandbox/v1 Runner. Production images must use @sha256 digests.
# These variables belong on the dedicated Runner host, not in the Next.js service.
SANDBOX_RUNNER_HOST=127.0.0.1
SANDBOX_RUNNER_PORT=8787
SANDBOX_RUNNER_AUTH_TOKEN=
# Use a different secret for Prometheus in production.
SANDBOX_RUNNER_METRICS_AUTH_TOKEN=
SANDBOX_RUNNER_MAX_CONCURRENCY=4
SANDBOX_RUNNER_MAX_REQUEST_BYTES=524288
SANDBOX_RUNNER_SHUTDOWN_GRACE_MS=125000
SANDBOX_RUNNER_READINESS_PROBE_INTERVAL_MS=30000
SANDBOX_RUNNER_READINESS_PROBE_TIMEOUT_MS=5000
SANDBOX_CONTAINER_RUNTIME=docker
SANDBOX_JAVASCRIPT_IMAGE=node@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43
SANDBOX_PYTHON_IMAGE=python@sha256:540c7d91f98ff6880174c40e99067bf5941eb54d818a7a5e094d188b196a934d
SANDBOX_RUNNER_REQUIRE_IMAGE_DIGEST=0
SANDBOX_RUNNER_CPU_LIMIT=1
SANDBOX_RUNNER_PIDS_LIMIT=64
SANDBOX_RUNNER_TMPFS_MB=16
# Leave empty to reject all network-enabled code Skills. A configured network
# must be dedicated and protected by operator-managed egress policy.
SANDBOX_RUNNER_EGRESS_NETWORK=

# Durable research worker identity and idle polling interval.
RESEARCH_WORKER_ID=
RESEARCH_WORKER_POLL_MS=2000

# P2 durable runtime scheduling. Values are clamped to safe bounds in code.
RESEARCH_TASK_CONCURRENCY=2
RESEARCH_WORKSPACE_CONCURRENCY=2
RESEARCH_PROVIDER_CONCURRENCY=4
RESEARCH_PROVIDER_RPM=30
RESEARCH_TASK_TIMEOUT_SECONDS=300
RESEARCH_RUN_TIMEOUT_SECONDS=1800

# Research Agent Controller rollout. Keep "off" for the deterministic DAG;
# "shadow" records model decisions but executes the normal ready wave;
# "active" applies validated call_tool/replan/ask_user actions while the Harness
# retains all permissions, budgets, retries, checkpoints, and final-report gates.
RESEARCH_AGENT_CONTROLLER_MODE=off
